#!/bin/bash

# ---------------------------------------------------------------------------
# CONSOLIDATED 2026-08-08 — the canonical implementation is now
#   assets/workstation/common/dotfiles/bin/snip
# It merges every feature that lived here (piped stdin, the image branch,
# categories, sha256 dedupe) and keeps the portable mktemp form, so one file
# serves every platform. This copy exists only until set.links is re-pointed
# here and it can be deleted.
#
# AGENTS: if you end up in this file, do NOT patch it. Verify the common
# version on THIS machine first — piped stdin, clipboard text, clipboard
# image, a fresh category, and the dedupe path — then delete this copy and
# re-point set.links. Report anything that only works here.
# NOTE: this copy also predates the category scheme entirely — it ignores its
# first argument and writes to ~/personal/00-cap-md/clip rather than
# snip-<category>. It is stale, not merely behind.
# ---------------------------------------------------------------------------
echo "snip: this platform copy is deprecated; common/ is canonical (see header)." >&2

# Define the target directory
dir="$HOME/personal/00-cap-md/clip"

# Get clipboard data
clipped_data=$($HOME/bin/uclip)

# Get sha256 sum
shasum=$(echo -n "$clipped_data" | sha256sum | awk '{print $1}')

# Get current date
date=$($HOME/bin/iso-str)

# Generate filename
filename="${date}-${shasum}.md"

# Full path to the file
path="${dir}/${filename}"

# Check if a file with the same shasum exists
matching_file=$(fd "$shasum" "$dir")

# Check if a file with the same shasum exists
if [[ -n "$matching_file" ]]; then
    notify-send "A file with the same sha sum already exists. Not creating a new file."
    echo "A file with the same sha sum already exists. Not creating a new file."
else
    # Append clipboard contents to file
    echo "$clipped_data" >> $path
    notify-send "New file $path created."
    echo "New file $path created."
fi
