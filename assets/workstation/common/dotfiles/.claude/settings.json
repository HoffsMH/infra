{
  "permissions": {
    "allow": [
      "Read(//var/folders/*/*/T/claude-clipboard-*/**)",
      "Read(//private/var/folders/*/*/T/claude-clipboard-*/**)",
      "Read(//tmp/claude-clipboard-*/**)",
      "mcp__clipboard-paste-mcp__paste_clipboard_screenshot"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/mh/bin/claude.tmux-pane"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$HOME/.agents/skills/i-have-adhd/always-on.sh\"",
            "timeout": 10,
            "statusMessage": "Checking i-have-adhd always-on flag..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true
}
