{
  "permissions": {
    "allow": [
      "Read(//var/folders/*/*/T/claude-clipboard-*/**)",
      "Read(//private/var/folders/*/*/T/claude-clipboard-*/**)",
      "Read(//tmp/claude-clipboard-*/**)",
      "mcp__clipboard-paste-mcp__paste_clipboard_screenshot"
    ]
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": true,
    "ruby-lsp@claude-plugins-official": true
  },
  "effortLevel": "xhigh",
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/mh/bin/claude.tmux-pane"
          }
        ]
      }
    ]
  },
  "tui": "fullscreen"
}
