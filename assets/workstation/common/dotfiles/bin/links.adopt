#!/bin/bash

dry_run=false

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run) dry_run=true; shift ;;
    -h|--help)
      printf 'Usage: %s [-n|--dry-run] FILE\n\n' "${0##*/}"
      printf 'Adopt one HOME file into the active platform dotfiles.\n'
      exit 0
      ;;
    --) shift; break ;;
    -*)
      printf 'Usage: %s [-n|--dry-run] FILE\n' "${0##*/}" >&2
      exit 2
      ;;
    *) break ;;
  esac
done

if [ $# -ne 1 ]; then
  printf 'Usage: %s [-n|--dry-run] FILE\n' "${0##*/}" >&2
  exit 2
fi

if [ -d "$HOME/infra" ]; then
  infradir="$HOME/infra"
elif [ -d "/opt/infra" ]; then
  infradir="/opt/infra"
else
  printf 'Error: infra directory not found in %s or /opt/infra\n' "$HOME" >&2
  exit 1
fi

is_omarchy() (
  ID=
  if [ -f /etc/os-release ]; then
    . /etc/os-release
  elif [ -f /usr/lib/os-release ]; then
    . /usr/lib/os-release
  fi
  [ "$ID" = omarchy ]
)

if [ "$(uname)" = "Darwin" ]; then
  platform="macOS"
  platform_dir="$infradir/assets/workstation/mac/dotfiles"
elif [ "$(uname)" = "Linux" ] && is_omarchy; then
  platform="Omarchy"
  platform_dir="$infradir/assets/workstation/omarchy/dotfiles"
else
  printf 'Unsupported platform: %s\n' "$(uname)" >&2
  exit 1
fi

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  green=$'\033[32m'
  yellow=$'\033[33m'
  cyan=$'\033[36m'
  bold=$'\033[1m'
  dim=$'\033[2m'
  reset=$'\033[0m'
else
  green=""
  yellow=""
  cyan=""
  bold=""
  dim=""
  reset=""
fi

warn() {
  printf '%s[NOOP]%s %s\n' "$yellow" "$reset" "$1" >&2
  exit 1
}

input="$1"
case "$input" in
  /*) input_path="$input" ;;
  *) input_path="$PWD/$input" ;;
esac

if [ -L "$input_path" ]; then
  link_target=$(readlink "$input_path")
  warn "source is already a symlink: $input_path -> $link_target"
fi
[ -d "$input_path" ] && warn "source is a directory: $input_path"
[ -e "$input_path" ] || warn "source does not exist: $input_path"
[ -f "$input_path" ] || warn "source is not a regular file: $input_path"
[ -r "$input_path" ] || warn "source is not readable: $input_path"

source_dir=$(cd -P "$(dirname "$input_path")" 2>/dev/null && pwd -P) || \
  warn "cannot resolve source directory: $(dirname "$input_path")"
source="$source_dir/$(basename "$input_path")"
home_root=$(cd -P "$HOME" 2>/dev/null && pwd -P) || warn "cannot resolve HOME: $HOME"
infra_root=$(cd -P "$infradir" 2>/dev/null && pwd -P) || warn "cannot resolve infra: $infradir"

case "$source" in
  "$home_root"/*) ;;
  *) warn "source is outside HOME: $source" ;;
esac

case "$source" in
  "$infra_root"|"$infra_root"/*) warn "source is already inside infra: $source" ;;
esac

relative=${source#"$home_root"}
common_target="$infradir/assets/workstation/common/dotfiles$relative"
platform_target="$platform_dir$relative"

if [ -e "$common_target" ] || [ -L "$common_target" ]; then
  warn "common dotfile already exists: $common_target"
fi

if [ -e "$platform_target" ] || [ -L "$platform_target" ]; then
  warn "$platform dotfile already exists: $platform_target"
fi

printf '%slinks.adopt%s  %s%s%s\n' "$bold" "$reset" "$dim" "$platform" "$reset"
printf '  source: %s\n' "$source"
printf '  target: %s\n' "$platform_target"

if [ "$dry_run" = true ]; then
  printf '  %s[?] would copy and link%s\n' "$cyan" "$reset"
  exit 0
fi

target_dir=$(dirname "$platform_target")
temporary_link="$source.links-adopt.$$"
if [ -e "$temporary_link" ] || [ -L "$temporary_link" ]; then
  warn "temporary path already exists: $temporary_link"
fi

mkdir -p "$target_dir" || warn "cannot create target directory: $target_dir"
cp -p "$source" "$platform_target" || warn "copy failed: $platform_target"

if ! ln -s "$platform_target" "$temporary_link"; then
  warn "could not create replacement symlink: $temporary_link"
fi

if ! mv -f "$temporary_link" "$source"; then
  command rm -f "$temporary_link"
  warn "could not replace source with symlink: $source"
fi

printf '  %s[+] adopted into %s%s\n' "$green" "$platform" "$reset"
printf '  %sReview the infra copy before promoting it to common.%s\n' "$dim" "$reset"
