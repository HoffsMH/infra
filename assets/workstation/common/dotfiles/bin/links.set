#!/bin/bash

if [ -d "$HOME/infra" ]; then
  infradir="$HOME/infra"
elif [ -d "/opt/infra" ]; then
  infradir="/opt/infra"
else
  printf 'Error: infra directory not found in %s or /opt/infra\n' "$HOME" >&2
  exit 1
fi

h="$HOME"
force=false
dry_run=false

while [ $# -gt 0 ]; do
  case "$1" in
    -f) force=true ;;
    -n) dry_run=true ;;
    *)
      printf 'Usage: %s [-f] [-n]\n' "${0##*/}" >&2
      exit 2
      ;;
  esac
  shift
done

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  green=$'\033[32m'
  yellow=$'\033[33m'
  cyan=$'\033[36m'
  magenta=$'\033[35m'
  bold=$'\033[1m'
  dim=$'\033[2m'
  reset=$'\033[0m'
else
  green=""
  yellow=""
  cyan=""
  magenta=""
  bold=""
  dim=""
  reset=""
fi

linked=0
skipped=0
planned=0
forced=0

print_action() {
  local color="$1"
  local marker="$2"
  local label="$3"
  local target="$4"
  local source="$5"

  printf '  %s%s %-10s%s %s%s%s -> %s\n' \
    "$color" "$marker" "$label" "$reset" "$dim" "$target" "$reset" "$source"
}

link_dotfiles() {
  local source_dir="$1"
  local section="$2"
  local file dirn basen newdirn target_dir newlink

  printf '\n%s%s%s %s%s%s\n' "$bold" "$section" "$reset" "$dim" "$source_dir" "$reset"

  while IFS= read -r -d '' file; do
    dirn=$(dirname "$file")
    basen=$(basename "$file")
    newdirn=${dirn#"$source_dir"}
    target_dir="$h$newdirn"
    newlink="$target_dir/$basen"

    if [ -e "$newlink" ] || [ -L "$newlink" ]; then
      if [ "$force" = true ]; then
        if [ "$dry_run" = true ]; then
          print_action "$cyan" "[?]" "would link" "$newlink" "$file"
          ((planned += 1))
        else
          mkdir -p "$target_dir"
          chmod go-rwx "$file"
          chmod u+rw "$file"
          ln -sfn "$file" "$newlink"
          print_action "$magenta" "[*]" "forced" "$newlink" "$file"
          ((forced += 1))
        fi
      else
        print_action "$yellow" "[-]" "skipped" "$newlink" "$file"
        ((skipped += 1))
      fi
    else
      if [ "$dry_run" = true ]; then
        print_action "$cyan" "[?]" "would link" "$newlink" "$file"
        ((planned += 1))
      else
        mkdir -p "$target_dir"
        chmod go-rwx "$file"
        chmod u+rw "$file"
        ln -s "$file" "$newlink"
        print_action "$green" "[+]" "linked" "$newlink" "$file"
        ((linked += 1))
      fi
    fi
  done < <(find "$source_dir" -type f -print0)
}

is_omarchy() (
  ID=
  if [ -f /etc/os-release ]; then
    . /etc/os-release
  elif [ -f /usr/lib/os-release ]; then
    . /usr/lib/os-release
  fi
  [ "$ID" = omarchy ]
)

if [ "$(uname)" = "Darwin" ]; then
  platform="macOS"
  platform_dir="$infradir/assets/workstation/mac/dotfiles"
elif [ "$(uname)" = "Linux" ] && is_omarchy; then
  platform="Omarchy"
  platform_dir="$infradir/assets/workstation/omarchy/dotfiles"
else
  printf 'Unsupported platform: %s\n' "$(uname)" >&2
  exit 1
fi

mode="normal"
[ "$force" = true ] && mode="force"
[ "$dry_run" = true ] && mode="dry run"

printf '%slinks.set%s  %s -> %s  %s(%s)%s\n' \
  "$bold" "$reset" "$infradir" "$h" "$dim" "$mode" "$reset"

link_dotfiles "$infradir/assets/workstation/common/dotfiles" "Common"
link_dotfiles "$platform_dir" "$platform"

printf '\n%sSummary%s\n' "$bold" "$reset"
printf '  %s[+] %-8s %d%s\n' "$green" "linked" "$linked" "$reset"
printf '  %s[-] %-8s %d%s\n' "$yellow" "skipped" "$skipped" "$reset"
printf '  %s[?] %-8s %d%s\n' "$cyan" "dry run" "$planned" "$reset"
printf '  %s[*] %-8s %d%s\n' "$magenta" "forced" "$forced" "$reset"
