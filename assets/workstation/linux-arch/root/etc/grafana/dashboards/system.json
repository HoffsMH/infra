{
 "uid": "sysperf",
 "title": "System performance",
 "tags": [
  "local"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "editable": true,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "graphTooltip": 1,
 "panels": [
  {
   "type": "row",
   "id": 1,
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 0
   },
   "panels": []
  },
  {
   "type": "timeseries",
   "id": 2,
   "title": "CPU busy by mode",
   "description": "Share of all cores. iowait means cores sat idle waiting on disk.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 15,
      "lineWidth": 1,
      "stacking": {
       "mode": "normal"
      },
      "showPoints": "never"
     },
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ],
     "sortBy": "Max",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "sum by (mode) (rate(node_cpu_seconds_total{mode!=\"idle\"}[$__rate_interval])) / scalar(count(count by (cpu) (node_cpu_seconds_total{mode=\"idle\"})))",
     "legendFormat": "{{mode}}",
     "refId": "A"
    }
   ]
  },
  {
   "type": "timeseries",
   "id": 3,
   "title": "Load average vs cores",
   "description": "",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 6,
    "x": 12,
    "y": 1
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 5,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ],
     "sortBy": "Max",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_load1",
     "legendFormat": "1m",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_load5",
     "legendFormat": "5m",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "node_load15",
     "legendFormat": "15m",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "count(count by (cpu) (node_cpu_seconds_total{mode=\"idle\"}))",
     "legendFormat": "cores",
     "refId": "D"
    }
   ]
  },
