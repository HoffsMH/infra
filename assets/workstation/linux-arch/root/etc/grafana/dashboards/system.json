  {
   "type": "timeseries",
   "id": 5,
   "title": "Pressure stall (PSI): time some task was stalled",
   "description": "The best single signal for 'the machine felt slow'. 'full' means every task was stalled.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 9
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "fillOpacity": 5,
      "lineWidth": 1,
      "stacking": {
       "mode": "none"
      },
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "mean",
      "max"
     ],
     "sortBy": "Max",
     "sortDesc": true
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_pressure_cpu_waiting_seconds_total[$__rate_interval])",
     "legendFormat": "cpu",
     "refId": "A"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_pressure_memory_waiting_seconds_total[$__rate_interval])",
     "legendFormat": "memory some",
     "refId": "B"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_pressure_memory_stalled_seconds_total[$__rate_interval])",
     "legendFormat": "memory full",
     "refId": "C"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_pressure_io_waiting_seconds_total[$__rate_interval])",
     "legendFormat": "io some",
     "refId": "D"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "rate(node_pressure_io_stalled_seconds_total[$__rate_interval])",
     "legendFormat": "io full",
     "refId": "E"
    }
   ]
  },
  {
   "type": "text",
   "id": 6,
   "title": "",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 9
   },
   "options": {
    "mode": "markdown",
    "content": "### Drilling in\n1. Drag across a spike on any graph to zoom the whole dashboard to it.\n2. The tables on the right of **Processes** rank what used the most over the zoomed range.\n3. For per-process detail at 5 s resolution (last 7 days):\n   `below replay -t \"yesterday 23:00\"`"
   }
  },
  {
   "type": "row",
   "id": 7,
   "title": "Processes (grouped by command name)",
   "collapsed": false,
   "gridPos": {
    "h": 1,
    "w": 24,
    "x": 0,
    "y": 17
   },
   "panels": []
  },
  {
   "type": "table",
   "id": 8,
   "title": "Top CPU over selected range (core-seconds)",
   "description": "Total CPU time each process group used across the zoomed range.",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "h": 16,
    "w": 8,
    "x": 16,
    "y": 18
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {
    "sortBy": [
     {
      "displayName": "Value",
      "desc": true
     }
    ]
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "expr": "topk(15, sum by (groupname) (increase(namedprocess_namegroup_cpu_seconds_total[$__range])))",
     "instant": true,
     "format": "table",
     "refId": "A"
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "groupname": "Process"
      }
     }
    }
   ]
  },
